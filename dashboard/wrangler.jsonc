{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hive-dashboard",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "services": [
    // The task board (cloud/tasks); /api/tasks signs in to it with the TASKS_TOKEN secret.
    {
      "binding": "TASKS",
      "service": "hive-tasks",
      "remote": true
    }
  ],
  // Workers AI: Whisper reads what you dictate on the website (/api/transcribe). In Hive's
  // window, Hive's own speech model reads it instead.
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  // `wrangler dev --env local` inherits everything except the service binding, so the server
  // reaches the board by TASKS_URL from the repository's .env. DASHBOARD_ACCESS_KEY,
  // DASHBOARD_SESSION_SECRET and TASKS_TOKEN are secrets: `wrangler secret put <NAME>`. Never put
  // them in this file.
  "env": {
    "local": {}
  }
}
