{
  "manifest_version": 3,
  "name": "Hive",
  "version": "1.18.1",
  "description": "Ask Hive from any page, and Hive changes how pages look for you; Hive's dashboard beside any page.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.workers.dev/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-rules.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Hive",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
