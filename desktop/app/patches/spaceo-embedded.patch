diff --git a/Sources/SpaceOKit/DisplayModeTransaction.swift b/Sources/SpaceOKit/DisplayModeTransaction.swift
new file mode 100644
index 0000000..87ee506
--- /dev/null
+++ b/Sources/SpaceOKit/DisplayModeTransaction.swift
@@ -0,0 +1,49 @@
+import Foundation
+
+/// Offline-testable transaction boundary. No live display adapter is supplied: private API
+/// selection, confirmation, topology safety and rollback have not been established.
+struct DisplayModeSize: Equatable {
+    let width: Int
+    let height: Int
+}
+
+protocol DisplayModeTransactionBacking: AnyObject {
+    var identity: UInt32 { get }
+    var descriptorLimit: DisplayModeSize { get }
+    func currentMode() -> DisplayModeSize?
+    func applyMode(_ mode: DisplayModeSize) -> Bool
+}
+
+enum DisplayModeTransactionResult: Equatable {
+    case invalid, unavailable, changed, rolledBack, rollbackFailed, identityChanged
+}
+
+enum DisplayModeTransaction {
+    /// Largest integral exact-aspect mode that fits both descriptor dimensions.
+    static func matchingMode(view: DisplayModeSize, limit: DisplayModeSize) -> DisplayModeSize? {
+        guard view.width > 0, view.height > 0, limit.width > 0, limit.height > 0 else { return nil }
+        func gcd(_ a: Int, _ b: Int) -> Int { var (x, y) = (a, b); while y != 0 { (x, y) = (y, x % y) }; return x }
+        let divisor = gcd(view.width, view.height)
+        let w = view.width / divisor, h = view.height / divisor
+        let scale = min(limit.width / w, limit.height / h)
+        guard scale > 0 else { return nil }
+        return DisplayModeSize(width: w * scale, height: h * scale)
+    }
+
+    static func change(_ backing: DisplayModeTransactionBacking, view: DisplayModeSize) -> DisplayModeTransactionResult {
+        let id = backing.identity
+        guard id != 0 else { return .unavailable }
+        guard let target = matchingMode(view: view, limit: backing.descriptorLimit) else { return .invalid }
+        guard let old = backing.currentMode(), old.width > 0, old.height > 0 else { return .unavailable }
+        guard backing.identity == id else { return .identityChanged }
+        if old == target { return .changed }
+        let accepted = backing.applyMode(target)
+        guard backing.identity == id else { return .identityChanged }
+        if accepted && backing.currentMode() == target && backing.identity == id { return .changed }
+        guard backing.identity == id else { return .identityChanged }
+        let restored = backing.applyMode(old)
+        guard backing.identity == id else { return .identityChanged }
+        guard restored && backing.currentMode() == old && backing.identity == id else { return .rollbackFailed }
+        return .rolledBack
+    }
+}
diff --git a/Tests/SpaceOKitTests/DisplayModeTransactionTests.swift b/Tests/SpaceOKitTests/DisplayModeTransactionTests.swift
new file mode 100644
index 0000000..5999205
--- /dev/null
+++ b/Tests/SpaceOKitTests/DisplayModeTransactionTests.swift
@@ -0,0 +1,36 @@
+import XCTest
+@testable import SpaceOKit
+
+final class DisplayModeTransactionTests: XCTestCase {
+    final class Fake: DisplayModeTransactionBacking {
+        var identity: UInt32 = 42
+        let descriptorLimit = DisplayModeSize(width: 1920, height: 1080)
+        var mode = DisplayModeSize(width: 1920, height: 1080)
+        var responses = [Bool]()
+        var calls = [DisplayModeSize]()
+        var changeIdentity = false
+        func currentMode() -> DisplayModeSize? { mode }
+        func applyMode(_ requested: DisplayModeSize) -> Bool {
+            calls.append(requested)
+            if changeIdentity { identity = 99 }
+            let ok = responses.isEmpty ? true : responses.removeFirst()
+            if ok { mode = requested }
+            return ok
+        }
+    }
+    let view = DisplayModeSize(width: 1710, height: 1107)
+    func testExactGeometryAndPointerMapping() {
+        let target = DisplayModeTransaction.matchingMode(view: view, limit: .init(width: 1920, height: 1080))!
+        XCTAssertEqual(target, .init(width: 1520, height: 984))
+        let m = MirrorInput.ViewportMapping(displayBounds: CGRect(x: 100, y: 50, width: target.width, height: target.height), viewSize: CGSize(width: view.width, height: view.height), stretch: true)
+        XCTAssertEqual(m.contentRect.size, CGSize(width: 1710, height: 1107))
+        let p = m.globalPoint(fromViewPoint: CGPoint(x: 855, y: 553.5))!
+        XCTAssertEqual(p.x, 860, accuracy: 0.001); XCTAssertEqual(p.y, 542, accuracy: 0.001)
+        XCTAssertEqual(m.contentRect.width / CGFloat(target.width), m.contentRect.height / CGFloat(target.height), accuracy: 0.00001)
+    }
+    func testSuccessAndIdentity() { let f = Fake(); XCTAssertEqual(DisplayModeTransaction.change(f, view: view), .changed); XCTAssertEqual(f.identity, 42); XCTAssertEqual(f.calls.count, 1) }
+    func testFailedApplyRollsBack() { let f = Fake(); f.responses = [false, true]; XCTAssertEqual(DisplayModeTransaction.change(f, view: view), .rolledBack); XCTAssertEqual(f.calls.count, 2) }
+    func testFailedRollback() { let f = Fake(); f.responses = [false, false]; XCTAssertEqual(DisplayModeTransaction.change(f, view: view), .rollbackFailed) }
+    func testIdentityChangeDoesNotTouchReplacement() { let f = Fake(); f.changeIdentity = true; XCTAssertEqual(DisplayModeTransaction.change(f, view: view), .identityChanged); XCTAssertEqual(f.calls.count, 1) }
+    func testInvalidGeometryDoesNotApply() { let f = Fake(); XCTAssertEqual(DisplayModeTransaction.change(f, view: .init(width: 0, height: 1)), .invalid); XCTAssertTrue(f.calls.isEmpty) }
+}
