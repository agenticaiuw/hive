<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The download runs with the hardened runtime (Apple notarizes nothing else), which turns
	     the microphone and camera off unless the app says it uses them: Hive listens when you tap
	     fn, and the eye keyboard reads the camera (tools/release.sh). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
