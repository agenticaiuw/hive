# Keeps this VM on the newest release of Hive's code (updater.mjs), run by hive-update.timer.
# Installed by the updater itself when a release changes it; first put in with:
#   sudo install -m 644 hive-update.service hive-update.timer /etc/systemd/system/ && sudo systemctl enable --now hive-update.timer
[Unit]
Description=Hive VM updater (puts in the newest release when nothing runs)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=HIVE_VM_STATE=/home/ubuntu/hive-vm-agent/state
ExecStart=/usr/local/bin/node /home/ubuntu/hive-vm-agent/app/updater.mjs
TimeoutStartSec=15min
