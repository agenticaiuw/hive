# Settings for the voice agent. Copy to .env (which git ignores) and fill in.
# A value here wins over the same variable in your shell; empty lines are ignored.

# OpenAI API key, for the voice that talks back (GPT-Live). Without one, ./voice.sh uses
# Superwhisper to listen and the Mac's built-in voice to read out the result.
OPENAI_API_KEY=

# GPT-Live model and voice. Voices: alloy, ash, ballad, beacon, cedar, coral, echo, juni, marin,
# meridian, quartz, sage, shimmer, verse, vesper, willow, ...
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin
# Seconds of quiet before a conversation closes. GPT-Live bills $0.05 a minute while one is open;
# holding Right Option opens a new one that remembers what was said.
LIVE_IDLE_SECONDS=45

# The computer agent (Codex), which does the actual work. Empty = your Codex config's model and
# reasoning effort (~/.codex/config.toml).
AGENT_MODEL=
AGENT_EFFORT=
