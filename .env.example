# Settings for the voice agent. Copy to .env (which git ignores) and fill in.
# A value here wins over the same variable in your shell; empty lines are ignored.

# Hearing you: Parakeet, an open-source speech recognition model that runs on this Mac.
# Empty = mlx-community/parakeet-tdt-0.6b-v2 (English). mlx-community/parakeet-tdt-0.6b-v3 also
# knows 24 other European languages.
STT_MODEL=
# Seconds of quiet that end what you're saying (it waits longer if you trailed off on "and...").
LISTEN_PAUSE=1.2
# After ./voice.sh --enroll it only listens to your voice. How alike a voice has to be to count as
# you (0.4; your own scores around 0.6-0.9): lower it if it ignores you, raise it if it hears others.
VOICE_MATCH=

# The agent's voice: Kokoro, an open-source text-to-speech model that runs on this Mac.
# Voices: af_heart (default), af_sarah, af_bella, am_michael, am_adam, bf_emma, bm_george, ...
# (af/am American, bf/bm British), or "say" for the Mac's own voice. Try one with
#   TTS_VOICE=am_michael .venv/bin/python python/speech.py "Hello."
TTS_VOICE=af_heart
TTS_SPEED=1.0

# The computer agent (Codex), which does the actual work. Empty AGENT_MODEL = gpt-6.1-terra.
# AGENT_EFFORT: low (default), medium, high, ...
AGENT_MODEL=
AGENT_EFFORT=

# Captions of what it says and does at the bottom of the screen. 0 = off.
CAPTIONS=

# Your iPhone: the Phone Control Automation project's relay folder (work/phone-relay, with
# endpoint.txt and private/secrets.json). Empty = no phone. Run the "Pocket Connect" Shortcut
# on the phone to connect it.
PHONE_RELAY=
