# =============================================================================
# Hive — the repository's one env file (.env at the repository root)
# =============================================================================
# Only the dashboard's local runs read it (`npm run dev` in dashboard/); the deployed dashboard
# Worker holds these as secrets instead (`wrangler secret put <NAME>`).

# The dashboard's sign-in key: at least 16 random characters.
PAIRING_CODE=replace-with-a-long-random-code

# Signs the dashboard's session cookie: at least 32 random characters, independent of the above.
SESSION_SECRET=replace-with-a-long-random-secret

# The task board (cloud/tasks) and its machine token, for a dashboard run without the Worker's
# TASKS service binding.
# TASKS_URL=https://hive-tasks.your-subdomain.workers.dev
# TASKS_TOKEN=...
