[Unit]
Description=Screen sharing of the VM agent desktop (:99), reachable only through SSH
After=vm-xvfb.service
Wants=vm-xvfb.service
StartLimitIntervalSec=0

[Service]
User=ubuntu
Group=ubuntu
ExecStart=/usr/local/bin/vm-screen-share
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
