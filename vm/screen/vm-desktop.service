[Unit]
Description=Desktop (openbox, taskbar with Terminal and Chrome) on the VM agent screen :99
After=vm-xvfb.service
Wants=vm-xvfb.service
StartLimitIntervalSec=0

[Service]
User=ubuntu
Group=ubuntu
ExecStart=/usr/local/bin/vm-desktop
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
